{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-lending-club-dev"
		},
		"LS_ADLS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stlendingclubdev01.dfs.core.windows.net/"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-lending-club-dev.vault.azure.net/"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azsqldbserver-lendingclub-dev.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azsqldb-lendingclub-dev"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Nagendra0524@"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_Gen2')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_Gen2_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_KeyVault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_Bronze_Parquet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_Gen2",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"container": {
						"type": "string"
					},
					"folder": {
						"type": "string"
					},
					"filename": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().filename",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folder",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().container",
							"type": "Expression"
						}
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_Gen2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AzureSQL')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_AzureSQL_properties_typeProperties_server')]",
					"database": "[parameters('LS_AzureSQL_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_KeyVault",
							"type": "LinkedServiceReference"
						},
						"secretName": "sql-password"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_KeyVault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AzureSQL_Control')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "dbo",
					"table": "pipeline_control"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AzureSQL_Source_Dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"SchemaName": {
						"type": "string"
					},
					"TableName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().SchemaName",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().TableName",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Child_IncrementalLoad')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_OldWatermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n'SELECT watermark_value \nFROM dbo.watermark_table \nWHERE source_name = ''',\npipeline().parameters.source_name,\n''''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSQL_Control",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Lookup_NewWatermark",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Lookup_OldWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n'SELECT CAST(MAX(',\npipeline().parameters.watermark_column,\n') AS VARCHAR(100)) AS new_watermark FROM ',\npipeline().parameters.source_schema,\n'.',\npipeline().parameters.source_table\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSQL_Control",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Copy_IncrementalData",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Lookup_NewWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n'SELECT * FROM ',\npipeline().parameters.source_schema,\n'.',\npipeline().parameters.source_table,\n' WHERE ',\npipeline().parameters.watermark_column,\n' > ''',\nactivity('Lookup_OldWatermark').output.firstRow.watermark_value,\n''' AND ',\npipeline().parameters.watermark_column,\n' <= ''',\nactivity('Lookup_NewWatermark').output.firstRow.new_watermark,\n''''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_AzureSQL_Source_Dynamic",
								"type": "DatasetReference",
								"parameters": {
									"SchemaName": {
										"value": "@pipeline().parameters.source_schema",
										"type": "Expression"
									},
									"TableName": {
										"value": "@pipeline().parameters.source_table",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_ADLS_Bronze_Parquet",
								"type": "DatasetReference",
								"parameters": {
									"container": {
										"value": "@pipeline().parameters.target_container",
										"type": "Expression"
									},
									"folder": {
										"value": "@concat(\npipeline().parameters.target_folder,\n'/',\nformatDateTime(utcNow(),'yyyy/MM/dd')\n)",
										"type": "Expression"
									},
									"filename": {
										"value": "@concat(\npipeline().parameters.source_name,\n'_',\nformatDateTime(utcNow(),'yyyyMMdd_HHmmss'),\n'.parquet'\n)",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "SP_UpdateWatermark",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "Copy_IncrementalData",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_update_watermark]",
							"storedProcedureParameters": {
								"new_watermark_value": {
									"value": {
										"value": "@activity('Lookup_NewWatermark').output.firstRow.new_watermark",
										"type": "Expression"
									},
									"type": "String"
								},
								"source_name": {
									"value": "",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "SP_LogRunSuccess",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "SP_UpdateWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_log_pipeline_run]",
							"storedProcedureParameters": {
								"adf_run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								},
								"rows_written": {
									"value": {
										"value": "@activity('Copy_IncrementalData').output.rowsCopied",
										"type": "Expression"
									},
									"type": "Int64"
								},
								"source_name": {
									"value": {
										"value": "@pipeline().parameters.source_name",
										"type": "Expression"
									},
									"type": "String"
								},
								"status": {
									"value": {
										"value": "SUCCESS",
										"type": "Expression"
									},
									"type": "String"
								},
								"watermark_from": {
									"value": {
										"value": "@activity('Lookup_OldWatermark').output.firstRow.watermark_value",
										"type": "Expression"
									},
									"type": "String"
								},
								"watermark_to": {
									"value": {
										"value": "@activity('Lookup_NewWatermark').output.firstRow.new_watermark",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"source_name": {
						"type": "string"
					},
					"source_schema": {
						"type": "string"
					},
					"source_table": {
						"type": "string"
					},
					"watermark_column": {
						"type": "string"
					},
					"watermark_datatype": {
						"type": "string"
					},
					"target_container": {
						"type": "string"
					},
					"target_folder": {
						"type": "string"
					},
					"target_format": {
						"type": "string"
					}
				},
				"variables": {
					"old_watermark": {
						"type": "String"
					},
					"new_watermar": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-06-20T05:41:42Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSQL_Control')]",
				"[concat(variables('factoryId'), '/datasets/DS_AzureSQL_Source_Dynamic')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Bronze_Parquet')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Master_MetadataDriven')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_PipelineConfig",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    pipeline_id,\n    source_name,\n    source_schema,\n    source_table,\n    watermark_column,\n    watermark_datatype,\n    target_container,\n    target_folder,\n    target_format,\n    load_type,\n    batch_size\nFROM dbo.pipeline_control\nWHERE is_active = 1;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSQL_Control",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Source",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_PipelineConfig",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_PipelineConfig').output.value",
								"type": "Expression"
							},
							"batchCount": 4,
							"activities": [
								{
									"name": "Switch_LoadType",
									"type": "Switch",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"on": {
											"value": "@item().load_type",
											"type": "Expression"
										},
										"cases": [
											{
												"value": "INCREMENTAL",
												"activities": [
													{
														"name": "Execute_Incremental",
														"type": "ExecutePipeline",
														"dependsOn": [],
														"policy": {
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"pipeline": {
																"referenceName": "PL_Child_IncrementalLoad",
																"type": "PipelineReference"
															},
															"waitOnCompletion": true,
															"parameters": {
																"source_name": {
																	"value": "@item().source_name",
																	"type": "Expression"
																},
																"source_schema": {
																	"value": "@item().source_schema",
																	"type": "Expression"
																},
																"source_table": {
																	"value": "@item().source_table",
																	"type": "Expression"
																},
																"watermark_column": {
																	"value": "@item().watermark_column",
																	"type": "Expression"
																},
																"watermark_datatype": {
																	"value": "@item().watermark_datatype",
																	"type": "Expression"
																},
																"target_container": {
																	"value": "@item().target_container",
																	"type": "Expression"
																},
																"target_folder": {
																	"value": "@item().target_folder",
																	"type": "Expression"
																},
																"target_format": {
																	"value": "@item().target_format",
																	"type": "Expression"
																}
															}
														}
													}
												]
											},
											{
												"value": "SCD2",
												"activities": [
													{
														"name": "SCD2_NotImplemented",
														"type": "Wait",
														"dependsOn": [],
														"userProperties": [],
														"typeProperties": {
															"waitTimeInSeconds": 1
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-06-20T05:41:42Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSQL_Control')]",
				"[concat(variables('factoryId'), '/pipelines/PL_Child_IncrementalLoad')]"
			]
		}
	]
}